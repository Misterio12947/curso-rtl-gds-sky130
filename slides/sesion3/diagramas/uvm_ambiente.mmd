flowchart LR
    TEST["<b>test</b><br/>elige secuencias<br/>(+UVM_TESTNAME)"]
    SEQ["<b>sequence</b><br/>QUÉ estímulo"]
    SQR["<b>sequencer</b><br/>reparte items"]
    DRV["<b>driver</b><br/>CÓMO:<br/>item → pines"]
    DUT["<b>DUT</b><br/>el RTL"]
    MON["<b>monitor</b><br/>pines → item"]
    SCB["<b>scoreboard</b><br/>modelo +<br/>comparador"]
    COV["<b>coverage</b><br/>covergroups"]

    TEST --> SEQ --> SQR --> DRV -- "interface" --> DUT
    DUT -- "interface" --> MON
    MON -- "analysis port" --> SCB
    MON -- "analysis port" --> COV

    subgraph AGT["agent"]
        SQR
        DRV
        MON
    end

    classDef t fill:#FFFFFF,stroke:#000,color:#000
    classDef est fill:#61CBF4,stroke:#000,color:#000
    classDef chk fill:#00B050,stroke:#000,color:#fff
    classDef cob fill:#FFC000,stroke:#000,color:#000
    classDef dut fill:#9933FF,stroke:#000,color:#fff
    class TEST,MON t
    class SEQ,SQR,DRV est
    class SCB chk
    class COV cob
    class DUT dut
