# Lab 01 · PDKs y Linux para VLSI
# ESQUELETO: los objetivos se implementan en la conversación de la sesión 1.
# Regla: se corre desde esta carpeta y solo usa rutas relativas.

ROOT   := ../..
RTL    := $(ROOT)/common/rtl/semaphore/rtl/semaphore.v
TB     := $(ROOT)/common/rtl/semaphore/tb/tb_semaphore.v
SDC    := $(ROOT)/common/sdc/semaforo.sdc

.DEFAULT_GOAL := help
.PHONY: help pdk rutas clean

help:
	@echo "Lab 01 · objetivos (pendientes de implementar):"
	@echo "  make pdk"
	@echo "  make rutas"
	@echo "  make clean"

pdk:
	@echo "[POR IMPLEMENTAR] make pdk"; exit 1

rutas:
	@echo "[POR IMPLEMENTAR] make rutas"; exit 1

clean:
	@echo "nada que limpiar todavía"
