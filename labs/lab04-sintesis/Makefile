# Lab 04 · Síntesis, `.lib` y SDC
# ESQUELETO: los objetivos se implementan en la conversación de la sesión 4.
# Regla: se corre desde esta carpeta y solo usa rutas relativas.

ROOT   := ../..
RTL    := $(ROOT)/common/rtl/semaphore/rtl/semaphore.v
TB     := $(ROOT)/common/rtl/semaphore/tb/tb_semaphore.v
SDC    := $(ROOT)/common/sdc/semaforo.sdc

.DEFAULT_GOAL := help
.PHONY: help synth netlist gls clean

help:
	@echo "Lab 04 · objetivos (pendientes de implementar):"
	@echo "  make synth"
	@echo "  make netlist"
	@echo "  make gls"
	@echo "  make clean"

synth:
	@echo "[POR IMPLEMENTAR] make synth"; exit 1

netlist:
	@echo "[POR IMPLEMENTAR] make netlist"; exit 1

gls:
	@echo "[POR IMPLEMENTAR] make gls"; exit 1

clean:
	@echo "nada que limpiar todavía"
