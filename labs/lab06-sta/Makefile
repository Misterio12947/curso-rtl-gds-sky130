.DEFAULT_GOAL := help
.PHONY: help sta corners fmax signoff clean

help:
	@echo "Lab 06 · objetivos (pendientes de implementar):"
	@echo "  make sta"
	@echo "  make corners"
	@echo "  make fmax"
	@echo "  make signoff"
	@echo "  make clean"

sta:
	@echo "[POR IMPLEMENTAR] make sta"; exit 1

corners:
	@echo "[POR IMPLEMENTAR] make corners"; exit 1

fmax:
	@echo "[POR IMPLEMENTAR] make fmax"; exit 1

signoff:
	@echo "[POR IMPLEMENTAR] make signoff"; exit 1

clean:
	@echo "nada que limpiar todavía"
